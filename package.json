{
  "name": "flatsby",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": "^11.28.0"
  },
  "packageManager": "pnpm@11.28.0+sha512.8ed239371de82244b6cccf9e2023c18ea8439961f2ec3fe898913b9f7ee2e76ca0a45717580aca3c7997c135f6d4f5de4524cbeee1a2ccac430c03d134e2a48c",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check format --continue",
    "check:fix": "turbo run check format --continue -- --write",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:generate": "turbo -F @flatsby/db generate",
    "db:migrate": "turbo -F @flatsby/db migrate",
    "db:push": "turbo -F @flatsby/db push",
    "db:studio": "turbo -F @flatsby/db studio",
    "dev": "bash scripts/setup-adb-reverse.sh; turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @flatsby/nextjs...",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "release": "node scripts/release.mjs",
    "typecheck": "turbo run typecheck",
    "ui-add": "pnpm dlx shadcn@latest add -c packages/ui"
  },
  "devDependencies": {
    "@flatsby/prettier-config": "workspace:*",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@flatsby/prettier-config"
}
