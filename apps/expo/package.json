{
  "name": "@flatsby/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "clean:cache": "rm -rf node_modules/.cache",
    "dev": "expo start",
    "dev:clean": "pnpm clean:cache && expo start --clear",
    "dev:fresh": "rm -rf node_modules/.cache .expo && expo start --clear",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "eas:build": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development",
    "eas:build:prod": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile production --auto-submit",
    "eas:build:local": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --local",
    "eas:update": "eas update --environment development",
    "eas:update:prod": "eas update --environment production",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test:e2e": "maestro test -e APP_ID=com.flatcove.app.v2 e2e/flows/",
    "test:e2e:android": "maestro test -e APP_ID=com.flatcove.app e2e/flows/",
    "test:e2e:ci": "node e2e/run-flows.mjs",
    "test:e2e:validate": "node e2e/validate-flows.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:better-auth",
    "@bottom-tabs/react-navigation": "^1.4.0",
    "@expo/metro-runtime": "~57.0.9",
    "@flatsby/validators": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.7.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-vector-icons/get-image": "^13.0.0",
    "@react-native-vector-icons/lucide": "^13.1.2",
    "@shopify/flash-list": "^2.3.2",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:better-auth",
    "expo": "~57.0.12",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "nativewind": "5.0.0-preview.4",
    "posthog-react-native": "^4.63.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.85.0",
    "react-native": "~0.86.2",
    "react-native-bottom-tabs": "^1.4.0",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-keyboard-controller": "1.22.3",
    "react-native-purchases": "10.7.1",
    "react-native-purchases-ui": "10.7.1",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "~0.10.1",
    "superjson": "catalog:",
    "tailwind-variants": "^3.3.1",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@flatsby/api": "workspace:*",
    "@flatsby/prettier-config": "workspace:*",
    "@flatsby/tailwind-config": "workspace:*",
    "@flatsby/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "cross-env": "^10.1.0",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "yaml": "2.9.0"
  },
  "prettier": "@flatsby/prettier-config"
}
