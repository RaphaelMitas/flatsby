{
  "name": "@flatsby/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "clean:cache": "rm -rf node_modules/.cache",
    "dev": "expo start",
    "dev:clean": "pnpm clean:cache && expo start --clear",
    "dev:fresh": "rm -rf node_modules/.cache .expo && expo start --clear",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "eas:build": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development",
    "eas:build:prod": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile production --auto-submit",
    "eas:build:local": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --local",
    "eas:build:e2e": "cross-env EXPO_NO_CAPABILITY_SYNC=1 eas build --local --profile e2e --platform ios --output build-cache/Flatsby.tar.gz",
    "eas:extract:e2e": "tar -xzf build-cache/Flatsby.tar.gz -C build-cache && rm build-cache/Flatsby.tar.gz",
    "clean:e2e": "rm -rf ios android build-cache",
    "build:e2e": "mkdir -p build-cache && pnpm eas:build:e2e && pnpm eas:extract:e2e",
    "e2e:sim:boot": "xcrun simctl shutdown Flatsby-E2E 2>/dev/null || true; sleep 2; xcrun simctl boot Flatsby-E2E && xcrun simctl bootstatus Flatsby-E2E",
    "e2e:sim:install": "xcrun simctl install Flatsby-E2E build-cache/Flatsby.app",
    "e2e:sim:shutdown": "xcrun simctl shutdown Flatsby-E2E || true",
    "e2e:run": "pnpm e2e:sim:boot && pnpm e2e:sim:install && pnpm test:e2e",
    "e2e": "pnpm build:e2e && pnpm e2e:run",
    "eas:update": "eas update --environment development",
    "eas:update:prod": "eas update --environment production",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:e2e:detox": "dotenv -e ../../.env -- detox test --configuration ios.sim.release",
    "test:e2e:detox:build": "dotenv -e ../../.env -- detox build --configuration ios.sim.release",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@babel/traverse--for-generate-function-map": "npm:@babel/traverse@^8.0.0",
    "@better-auth/expo": "catalog:better-auth",
    "@bottom-tabs/react-navigation": "^1.3.1",
    "@expo/metro-runtime": "~55.0.11",
    "@flatsby/validators": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-vector-icons/get-image": "^13.0.0",
    "@react-native-vector-icons/lucide": "^13.1.2",
    "@shopify/flash-list": "^2.3.2",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:better-auth",
    "expo": "~55.0.17",
    "expo-application": "~55.0.14",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.13",
    "expo-dev-client": "55.0.24",
    "expo-device": "~55.0.14",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.12",
    "expo-localization": "~55.0.13",
    "expo-network": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.17",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.15",
    "expo-updates": "~55.0.20",
    "expo-web-browser": "~55.0.14",
    "nativewind": "5.0.0-preview.4",
    "posthog-react-native": "^4.52.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.80.0",
    "react-native": "~0.83.4",
    "react-native-bottom-tabs": "^1.3.1",
    "react-native-css": "3.0.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-keyboard-controller": "1.21.12",
    "react-native-purchases": "9.15.2",
    "react-native-purchases-ui": "9.15.2",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "~0.7.2",
    "superjson": "catalog:",
    "tailwind-variants": "^3.2.2",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@flatsby/api": "workspace:*",
    "@flatsby/eslint-config": "workspace:*",
    "@flatsby/prettier-config": "workspace:*",
    "@flatsby/tailwind-config": "workspace:*",
    "@flatsby/tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "cross-env": "^10.1.0",
    "detox": "^20.47.0",
    "dotenv-cli": "^11.0.0",
    "eas-cli": "^20.5.1",
    "eslint": "catalog:",
    "expo-detox-config-plugin": "^12.0.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "ts-jest": "^29.4.6",
    "typescript": "catalog:"
  },
  "prettier": "@flatsby/prettier-config"
}
