{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:expoMonorepo"
  ],
  "baseBranchPatterns": ["main"],
  "prConcurrentLimit": 2,
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "One bundled PR for all security fixes. Renovate exempts vulnerability alerts from prConcurrentLimit, so this ships even when the 2-PR budget is full; minimumReleaseAge is cleared so fixes are not held for a day",
    "enabled": true,
    "groupName": "security-fixes",
    "groupSlug": "security-fixes",
    "labels": ["dependencies", "security"],
    "prCreation": "immediate",
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "schedule": []
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Expo-managed deps – update via `expo doctor --fix-dependencies`, not Renovate",
      "matchFileNames": ["apps/expo/package.json"],
      "matchPackageNames": [
        "/^expo/",
        "/^@expo//",
        "react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets",
        "react-native-css",
        "@react-native-async-storage/async-storage",
        "@react-native-community/datetimepicker"
      ],
      "enabled": false
    },
    {
      "description": "React pinned to Expo SDK-compatible version – update when upgrading Expo SDK",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "enabled": false
    },
    {
      "description": "Group Next.js",
      "groupName": "nextjs",
      "matchPackageNames": ["next", "@next/env"]
    },
    {
      "description": "Group tRPC",
      "groupName": "trpc",
      "matchPackageNames": ["/^@trpc//"]
    },
    {
      "description": "Group Drizzle",
      "groupName": "drizzle",
      "matchPackageNames": ["/^drizzle-/"]
    },
    {
      "description": "Group Tailwind CSS",
      "groupName": "tailwindcss",
      "matchPackageNames": ["/^@tailwindcss//", "/^tailwindcss$/"]
    },
    {
      "description": "Group Radix UI",
      "groupName": "radix-ui",
      "automerge": true,
      "matchPackageNames": ["/^@radix-ui//"]
    },
    {
      "description": "Group AI SDK",
      "groupName": "ai-sdk",
      "matchPackageNames": ["/^@ai-sdk//", "/^ai$/"]
    },
    {
      "description": "Group Tanstack",
      "groupName": "tanstack",
      "matchPackageNames": ["/^@tanstack//"]
    },
    {
      "description": "Group Biome",
      "groupName": "biome",
      "matchPackageNames": ["/^@biomejs//"]
    },
    {
      "description": "Group PostHog",
      "groupName": "posthog",
      "matchPackageNames": ["/^posthog/", "/^@posthog//"]
    },
    {
      "description": "Group type definitions",
      "groupName": "types",
      "automerge": true,
      "matchPackageNames": ["/^@types//"]
    },
    {
      "description": "Group React Native Vector Icons",
      "groupName": "react-native-vector-icons",
      "matchPackageNames": ["/^@react-native-vector-icons//"]
    },
    {
      "description": "Group Better Auth. 1.6.24-1.6.27 break client plugin types (expoClient not assignable to BetterAuthClientPlugin, https://github.com/better-auth/better-auth/issues/10767) – the Expo typecheck fails while web stays green, so extend this range if the next release is still broken, and drop the exclusion once a fixed one ships",
      "groupName": "better-auth",
      "matchPackageNames": ["/^@better-auth//", "better-auth"],
      "allowedVersions": "!/^1\\.6\\.2[4-7]$/"
    },
    {
      "description": "lightningcss > 1.30.1 breaks the react-native-css Metro transformer and fails both native E2E builds (parcel-bundler/lightningcss#1065). Pinned for react-native-css and @expo/metro-config in pnpm-workspace.yaml – re-enable once upstream is fixed",
      "matchPackageNames": ["lightningcss", "/^lightningcss-/"],
      "enabled": false
    },
    {
      "description": "Group RevenueCat",
      "groupName": "revenuecat",
      "matchPackageNames": ["/^react-native-purchases/"]
    },
    {
      "description": "Bundle every minor/patch/digest bump into a single PR. Must stay last so it overrides the per-library groups above, which then only apply to majors",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}
