{
  "name": "@flatsby/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx",
    "./categories": "./src/categories/index.ts",
    "./categories/*": "./src/categories/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./hooks/*.ts",
    "./ai-elements/*": "./src/components/ai-elements/*.tsx"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "check": "biome check",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "ui-add": "pnpm dlx shadcn@latest add"
  },
  "dependencies": {
    "@flatsby/i18n": "workspace:*",
    "@flatsby/validators": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.68.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "catalog:",
    "react-resizable-panels": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@flatsby/prettier-config": "workspace:*",
    "@flatsby/tailwind-config": "workspace:*",
    "@flatsby/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react19",
    "zod": "catalog:"
  },
  "prettier": "@flatsby/prettier-config"
}
