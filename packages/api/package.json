{
  "name": "@flatsby/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./calendarCache": {
      "types": "./dist/calendarCache.d.ts",
      "default": "./src/calendarCache.ts"
    },
    "./hooks/useShoppingListSuggestions": {
      "types": "./dist/hooks/useShoppingListSuggestions.d.ts",
      "default": "./src/hooks/useShoppingListSuggestions.ts"
    },
    "./posthog": {
      "types": "./dist/lib/posthog.d.ts",
      "default": "./src/lib/posthog.ts"
    },
    "./resultMutation": {
      "types": "./dist/resultMutation.d.ts",
      "default": "./src/resultMutation.ts"
    },
    "./shoppingListsCache": {
      "types": "./dist/shoppingListsCache.d.ts",
      "default": "./src/shoppingListsCache.ts"
    },
    "./shoppingListItemsCache": {
      "types": "./dist/shoppingListItemsCache.d.ts",
      "default": "./src/shoppingListItemsCache.ts"
    },
    "./trpcFailure": {
      "types": "./dist/trpcFailure.d.ts",
      "default": "./src/trpcFailure.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "check": "biome check",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/provider": "catalog:",
    "@flatsby/auth": "workspace:*",
    "@flatsby/db": "workspace:*",
    "@flatsby/i18n": "workspace:*",
    "@flatsby/validators": "workspace:*",
    "@posthog/ai": "8.14.1",
    "@posthog/core": "^1.59.1",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "effect": "^4.0.5",
    "posthog-node": "^5.56.2",
    "superjson": "catalog:",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/vitest": "catalog:",
    "@flatsby/prettier-config": "workspace:*",
    "@flatsby/tsconfig": "workspace:*",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-pacer": "*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "react": "catalog:react19"
  },
  "prettier": "@flatsby/prettier-config"
}
